# Copie este arquivo para ".env" e preencha:
#   cp .env.example .env

# ── Servidor / produção ──
# "production" no deploy: ativa cookie secure (HTTPS), esconde devCodes, exige JWT_SECRET forte.
# Em desenvolvimento, deixe vazio (roda em modo dev).
NODE_ENV=production
PORT=3001                              # porta do backend (o Nginx faz proxy pra ela)
# URL PÚBLICA do site — usada nas URLs de retorno do Stripe e como base do OAuth do Discord.
# Em dev: http://localhost:5173
CORS_ORIGIN=https://seudominio.com

# ── Sessão ──
# OBRIGATÓRIO em produção: ≥32 caracteres aleatórios. O servidor NÃO sobe com o valor padrão.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-isto-em-producao

# ── Email (troca de senha / código 2FA) ──
# Senha de APP do Gmail (não é a senha normal da conta!)
# Como gerar: myaccount.google.com → Segurança → Verificação em duas etapas → Senhas de app
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── Discord (login OAuth + bot que aplica o cargo Alpha) ──
# Dev Portal: discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=                      # ID do servidor
DISCORD_ALPHA_ROLE_ID=                 # ID do cargo Alpha (o bot precisa estar ACIMA dele na hierarquia)
# Em produção aponte pro domínio E adicione esta MESMA URL em "Redirects" no Dev Portal:
DISCORD_REDIRECT_URI=https://seudominio.com/api/auth/discord/callback
DISCORD_INVITE_URL=https://discord.gg/seuconvite   # convite do servidor (plano gratuito + DM pós-pagamento)

# ── Stripe (pagamento cartão/PIX) ──
# Painel: dashboard.stripe.com/apikeys  (TESTE: sk_test_... | PRODUÇÃO: sk_live_... )
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret do webhook. DEV: rode `stripe listen --forward-to localhost:3001/api/webhooks/stripe` e copie o whsec_.
# PRODUÇÃO: crie o endpoint https://seudominio.com/api/webhooks/stripe no painel da Stripe e copie o whsec_ dele.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Rewardful (programa de afiliados) ──
# API Secret: Rewardful → Settings → API. Fica SÓ no backend.
REWARDFUL_API_SECRET=
# Opcional: fixar o ID da campanha. Vazio = backend usa a campanha padrão automaticamente.
REWARDFUL_CAMPAIGN_ID=

# ── Solana (pagamento em SOL) ──
# Endereços PÚBLICOS (não são segredos). Sem private key — o usuário assina na carteira.
SOLANA_RECEIVE_WALLET=                 # carteira que recebe 90% do pagamento
SOLANA_FEE_WALLET=                     # carteira que recebe os 10% (taxa) — fundar 1x com ~0.001 SOL p/ rent-exempt
# RPC: vazio = mainnet pública (rate-limit). Em produção, use Helius/QuickNode. Devnet p/ testes:
# SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=
